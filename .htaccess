# A-DevTools — root access control
#
# Folder tiers (see SECURITY.md for the full breakdown):
#   /core     internal-only PHP (config, db, security, auth-helpers) — never
#             requested directly, only `require`d. Blocked by core/.htaccess.
#   /cli      command-line-only scripts (migrate.php). Blocked by cli/.htaccess.
#   /data     all persisted data (backups, throttle file, and any legacy
#             JSON fallback files). Blocked by data/.htaccess.
#   /database, /sql   SQL schema/migration files, imported manually via
#             phpMyAdmin or the mysql CLI — never fetched over HTTP.
#             Blocked by their own .htaccess.
#   /assets, /downloads   public static files — intentionally web-readable.
#
# This file protects individual files that still have to live in the app
# root (to keep XAMPP's htdocs/<app>/ layout simple) but must never be
# requested directly over HTTP.

Options -Indexes
ServerSignature Off

# The runtime backup-location config file (created by save-data.php) can
# contain a filesystem path — no reason for it to be web-readable.
<FilesMatch "^save-config\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
